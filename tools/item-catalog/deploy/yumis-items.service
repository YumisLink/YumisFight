[Unit]
Description=Yumis item catalog
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/srv/yumis-items/app
Environment=CATALOG_DATA=/srv/yumis-items/data
Environment=CATALOG_SEED=/srv/yumis-items/app/seed
Environment=CATALOG_PORT=18753
ExecStart=/usr/bin/node /srv/yumis-items/app/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/yumis-items/data

[Install]
WantedBy=multi-user.target
