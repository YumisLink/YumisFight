{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "common",
        "model": {
          "type": "minecraft:model",
          "model": "yumis_dungeon_and_fight:item/waystone_common"
        }
      },
      {
        "when": "rare",
        "model": {
          "type": "minecraft:model",
          "model": "yumis_dungeon_and_fight:item/waystone_rare"
        }
      },
      {
        "when": "artifact",
        "model": {
          "type": "minecraft:model",
          "model": "yumis_dungeon_and_fight:item/waystone_artifact"
        }
      },
      {
        "when": "legendary",
        "model": {
          "type": "minecraft:model",
          "model": "yumis_dungeon_and_fight:item/waystone_legendary"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "yumis_dungeon_and_fight:item/waystone_common"
    }
  }
}
