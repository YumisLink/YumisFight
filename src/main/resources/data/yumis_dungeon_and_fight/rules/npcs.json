{
  "npcs": {
    "ark_war_guide": {
      "name": "方舟战争引导员",
      "stationary": true,
      "actions": [
        {
          "id": "participate",
          "label": "参加方舟战争",
          "type": "ark_war",
          "value": "join"
        },
        {
          "id": "withdraw",
          "label": "取消参加",
          "type": "ark_war",
          "value": "withdraw"
        },
        {
          "id": "leave",
          "label": "返回进入前的位置",
          "type": "ark_war",
          "value": "leave"
        },
        {
          "id": "confirm_start",
          "label": "确认开始本局",
          "type": "ark_war",
          "value": "confirm_start"
        },
        {
          "id": "cancel_start",
          "label": "取消开始确认",
          "type": "ark_war",
          "value": "cancel_start"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "在水晶旁报名后，请所有报名者确认开始。本局最多四人，其他来访者可以观战。",
        "开始时锁定参战名单。商品框全部用于购买，刷新、升本和准备各用独立告示牌；战斗期间可以买角色，下一波再布阵。已有卡牌对应的商品框会发光。"
      ]
    },
    "mobs_merchant": {
      "name": "怪物掉落商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "mobs"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "外头的怪物可不安分。",
        "缺哪种材料？到摊上看看。",
        "这些材料我都仔细挑过了。",
        "出远门前，记得把补给备齐。"
      ]
    },
    "wood_merchant": {
      "name": "木头商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "wood"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "木头的纹理各有各的好看。",
        "盖房子还是做工具？慢慢挑。",
        "下界的菌木也有货。",
        "今天的原木已经整理好了。"
      ]
    },
    "stone_merchant": {
      "name": "石头商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "stone"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "打好地基，房子才住得安心。",
        "这些石料拿去盖房子正合适。",
        "圆石和石头都给你备着。",
        "想修路的话，别忘了多带些石料。"
      ]
    },
    "food_merchant": {
      "name": "食物商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "food"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "赶路前先吃饱。",
        "今天想来点什么？",
        "背包里留些吃的总没错。",
        "闻到香味了吗？刚好该补充食物了。"
      ]
    },
    "crystal_merchant": {
      "name": "魔能水晶商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "crystal"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "魔能水晶要按阶位分清楚。",
        "不同阶的水晶，储存的魔能可不一样。",
        "需要补充魔能的话，来我这儿看看。",
        "给机器备点水晶，做事也安心些。"
      ]
    },
    "elaina": {
      "name": "伊蕾娜",
      "skin": "elaina",
      "headwear": "witch_hat",
      "title": "旅途引路人",
      "unique": true,
      "actions": [
        {
          "id": "tutorial",
          "label": "旅途指引",
          "type": "tutorial",
          "value": "elaina"
        }
      ],
      "dialogue": [
        "冒险这种事，先学会第一步就够了。",
        "选你喜欢的。旅途可没有标准答案。"
      ]
    }
  },
