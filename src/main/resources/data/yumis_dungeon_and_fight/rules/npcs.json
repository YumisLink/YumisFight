          "type": "shop",
          "value": "mobs"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "外头的怪物可不安分。",
        "缺哪种材料？到摊上看看。",
        "这些材料我都仔细挑过了。",
        "出远门前，记得把补给备齐。"
      ]
    },
    "wood_merchant": {
      "name": "木头商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "wood"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "木头的纹理各有各的好看。",
        "盖房子还是做工具？慢慢挑。",
        "下界的菌木也有货。",
        "今天的原木已经整理好了。"
      ]
    },
    "stone_merchant": {
      "name": "石头商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "stone"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "打好地基，房子才住得安心。",
        "这些石料拿去盖房子正合适。",
        "圆石和石头都给你备着。",
        "想修路的话，别忘了多带些石料。"
      ]
    },
    "food_merchant": {
      "name": "食物商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "food"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "赶路前先吃饱。",
        "今天想来点什么？",
        "背包里留些吃的总没错。",
        "闻到香味了吗？刚好该补充食物了。"
      ]
    },
    "crystal_merchant": {
      "name": "魔能水晶商人",
      "actions": [
        {
          "id": "shop",
          "label": "商店",
          "type": "shop",
          "value": "crystal"
        },
        {
          "id": "chat",
          "label": "交流",
          "type": "chat",
          "value": ""
        }
      ],
      "dialogue": [
        "魔能水晶要按阶位分清楚。",
        "不同阶的水晶，储存的魔能可不一样。",
        "需要补充魔能的话，来我这儿看看。",
        "给机器备点水晶，做事也安心些。"
      ]
    }
